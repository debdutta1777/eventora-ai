# Both are public client configuration, protected by database RLS.
# Blank values use Eventora's public development-project defaults.
# To disable accounts and run the browser-only demo:
# VITE_DEMO_ONLY=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only, if your project has not adopted publishable keys:
# VITE_SUPABASE_ANON_KEY=
# Never put a secret/service-role key or database password in VITE_* variables.
